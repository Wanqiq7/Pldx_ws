<?xml version="1.0"?>
<package format="3">
  <name>sim_nav_adapter</name>
  <version>0.1.0</version>
  <description>Canonical navigation interfaces for the Gazebo simulation.</description>
  <maintainer email="87068644+fishros@users.noreply.github.com">navi workspace</maintainer>
