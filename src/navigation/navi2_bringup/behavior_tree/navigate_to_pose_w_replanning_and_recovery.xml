<!--
  Submit the goal initially and whenever it changes. MINCO owns trajectory replanning.
  Keep planning / control recovery actions as well as general system recovery.
-->
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="3" name="NavigateRecovery">
      <MincoGoalUpdater input_goal="{goal}" output_goal="{updated_goal}">
        <PipelineSequence name="NavigateWithReplanning">
          <GoalUpdatedController goal="{updated_goal}">
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <Sequence name="ComputeAndSmoothPath">
                <ComputePathToPose goal="{updated_goal}" path="{path}" planner_id="MincoPlanner"/>
                <SmoothPath unsmoothed_path="{path}" smoothed_path="{smoothed_path}"/>
              </Sequence>

              <ClearCostmapAroundRobot name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_around_global_costmap" reset_distance="2.0"/>
            </RecoveryNode>
          </GoalUpdatedController>
          <RecoveryNode number_of_retries="1" name="FollowPath">
            <FollowPath path="{smoothed_path}" controller_id="FollowPath"/>
            <ClearCostmapAroundRobot name="ClearLocalCostmap-Context" service_name="local_costmap/clear_around_local_costmap" reset_distance="1.0"/>
          </RecoveryNode>
        </PipelineSequence>
      </MincoGoalUpdater>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Wait wait_duration="1.0"/>
          <!-- <BackUp backup_dist="0.3" backup_speed="0.05"/> -->
          <!-- <Spin spin_dist="0.523"/> -->
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
